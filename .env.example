# Project PA Environment Configuration Example
# Duplicate this file to '.env' and populate with your credentials.

# ── Core System Configuration ──
SECRET_KEY=enter-a-highly-secure-random-phrase-here
JWT_SECRET_KEY=enter-a-secure-jwt-signing-key-here
DATABASE_URL=sqlite:///project_pa.db

# ── Email Notifications & SMTP (Optional) ──
# For real Gmail notifications:
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an App Password (https://myaccount.google.com/apppasswords)
# 3. Paste the generated 16-character password below.
MAIL_USERNAME=deeppatel26075@gmail.com
MAIL_PASSWORD=your-16-character-gmail-app-password

# ── Environment Modes ──
FLASK_DEBUG=1
WERKZEUG_RUN_MAIN=true
